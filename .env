# ==========================================
# FixAI Local Environment Configuration
# ==========================================

# Port for local server
PORT=3000
NODE_ENV=development

# JWT Secret for Session & Authentication Tokens
JWT_SECRET=fixai_secret_jwt_key_development_2026_secure

# Owner Account Initialization (Auto-created on first startup if configured)
OWNER_EMAIL=admin@fixai.app
OWNER_PASSWORD=AdminPassword123!

# SQLite Database Location
DB_PATH=fixai.db

# Email / SMTP Configuration (Optional)
# If left empty, OTP codes will be printed directly to your terminal console!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FixAI" <no-reply@fixai.app>
