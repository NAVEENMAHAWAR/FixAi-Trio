# ==========================================
# FixAI Environment Configuration Template
# ==========================================

# Server Configuration
# Note: Render automatically assigns PORT (usually 10000). Leave commented or set for local dev.
PORT=3000
NODE_ENV=production

# JWT Secret for Session & Authentication Tokens (Replace with a random 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Owner Account Initialization (Auto-created on first startup if configured)
OWNER_EMAIL=admin@fixai.app
OWNER_PASSWORD=ChangeThisPassword123!

# SQLite Database Location
# Default: fixai.db in root directory.
# If using a Render Persistent Disk mounted at /var/data, set:
# DB_PATH=/var/data/fixai.db
DB_PATH=fixai.db

# Email / SMTP Configuration (Optional: if not set, emails & OTPs log to server console)
# For Gmail, use App Passwords (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="FixAI Support" <your-email@gmail.com>
